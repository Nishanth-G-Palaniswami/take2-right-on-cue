# Copy this file to .env and put your real keys there. Never commit .env.
# Needed only when an OpenAI model (gpt-...) is selected.
OPENAI_API_KEY=your-openai-api-key-here
# Needed only when a Gemini model (gemini-...) is selected. The tool reads only
# GEMINI_API_KEY (never GOOGLE_API_KEY).
GEMINI_API_KEY=your-gemini-api-key-here
